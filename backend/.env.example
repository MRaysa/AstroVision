# AstroVision backend configuration (all variables optional; sensible defaults apply).
# Copy to `.env` and adjust as needed.

# Comma-separated list of allowed CORS origins (your frontend URL[s]).
ASTROVISION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum upload size in bytes (default 64 MB).
# ASTROVISION_MAX_UPLOAD_BYTES=67108864

# Number of loaded images kept in memory before LRU eviction.
# ASTROVISION_MAX_CACHED_IMAGES=32
